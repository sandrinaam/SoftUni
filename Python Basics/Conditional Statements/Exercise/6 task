import math
record = float(input())
distance_in_metres = float(input())
time_per_metre = float(input())

time_seconds = distance_in_metres * time_per_metre
extra_time = math.floor (distance_in_metres / 15) * 12.5
total_time = time_seconds + extra_time
difference = abs(total_time - record)

if total_time < record:
    print(f'Yes, he succeeded! The new world record is {total_time:.2f} seconds.')

else:
    print(f'No, he failed! He was {difference:.2f} seconds slower.')
