width = int(input())
height = int(input())
length = int(input())
free_space = width * height * length

command = input()

while command != 'Done':
    boxes = int(command)
    free_space -= boxes

    if free_space <= 0:
     print(f'No more free space! You need {abs(free_space)} Cubic meters more.')
     break

    command = input()
else:
    print(f'{free_space} Cubic meters left.')
