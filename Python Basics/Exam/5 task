kids = 0
adults = 0
price_toy = 5
price_sweaters = 15

while True:
    command = input()
    if command == 'Christmas':
        break
    age = int(command)
    if age <= 16:
        kids += 1
    else:
        adults += 1
print(f'Number of adults: {adults}')
print(f'Number of kids: {kids}')
print(f'Money for toys: {price_toy * kids}')
print(f'Money for sweaters: {price_sweaters * adults}')
