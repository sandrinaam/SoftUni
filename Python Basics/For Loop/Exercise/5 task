n = int(input())
salary = (int(input()))

for _ in range(n):
    browse = input()
    if browse == 'Facebook':
        salary -= 150
    elif browse == 'Instagram':
        salary -= 100
    elif browse == 'Reddit':
        salary -= 50
    if salary <= 0:
            print("You have lost your salary.")
            break
else:
    print(salary)
