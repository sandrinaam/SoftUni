age = int(input())
washing_price = float(input())
toys_price = int(input())

money_saved = 0
money_gift = 10
toys_number = 0

for num in range(1, age + 1):
    if num % 2 == 0:
        money_saved += money_gift
        money_gift += 10
        money_saved -= 1

    else:
        toys_number += 1

money_saved += toys_number * toys_price
difference = abs(money_saved - washing_price)

if money_saved >= washing_price:
    print(f'Yes! {difference:.2f}')
else:
    print(f'No! {difference:.2f}')

