contests_dict = {}
data = {}

while True:
    line = input()
    if line == 'end of contests':
        break

    contest, password = line.split(":")
    contests_dict[contest] = password

while True:
    line = input()
    if line == 'end of submissions':
        break

    contest, password, username, points = line.split("=>")
    points = int(points)

    if contest in contests_dict and contests_dict[contest] == password:
        if username not in data:
            data[username] = {}

        if contest not in data[username]:
            data[username][contest] = points

        else:
            data[username][contest] = max(data[username][contest], points)

best_user = ''
max_points = 0

for user, contests in data.items():
    total_points = sum(contests.values())
    if total_points > max_points:
        max_points = total_points
        best_user = user

print(f'Best candidate is {best_user} with total {max_points} points.')
print("Ranking:")

for user in sorted(data):
    print(user)
    for contest,points in sorted(data[user].items(), key = lambda x:-x[1]):
        print(f'#  {contest} -> {points}')



