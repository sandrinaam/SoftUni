parking_lot = {}
num_of_commands = int(input())

for i in range(num_of_commands):
    command = input().split()

    command_ = command[0]
    username = command[1]

    if command_ == 'register':
        plate_number = command[2]

        if username in parking_lot.keys():
            print(f'ERROR: already registered with plate number {plate_number}')

        else:
            parking_lot[username] = plate_number
            print(f'{username} registered {plate_number} successfully')

    elif command_ == 'unregister':
        if username in parking_lot.keys():
            print(f'{username} unregistered successfully')
            del parking_lot[username]

        else:
            print(f'ERROR: user {username} not found')

for username, plate_number in parking_lot.items():
    print(f'{username} => {plate_number}')




