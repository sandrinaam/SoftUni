phonebook = {}

while True:
    entry = input()
    if "-" not in entry:
        break
    name, number = entry.split("-")
    phonebook[name] = number

number = int(entry)

for i in range(number):
    name = input()
    if name in phonebook:
        print(f'{name} -> {phonebook[name]}')
    else:
        print(f'Contact {name} does not exist.')
