animals = input().split(', ')
animals_list = list(animals)
wolf_index = animals_list.index('wolf')

if animals_list[-1] == 'wolf':
    print('Please go away and stop eating my sheep')
else:
    sheep_number = len(animals_list) - wolf_index - 1
    print(f'Oi! Sheep number {sheep_number}! You are about to be eaten by a wolf!')
