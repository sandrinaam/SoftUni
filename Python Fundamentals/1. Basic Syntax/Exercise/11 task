budget = float(input())
price_per_kg_flour = float(input())

price_per_eggs = 0.75 * price_per_kg_flour
price_l_milk = price_per_kg_flour *  1.25
price_per_loaf_milk = price_l_milk * 0.25

bread_count = 0
eggs_count = 0

while True:
    total_price_per_loaf = price_per_kg_flour + price_per_eggs + price_per_loaf_milk
    if budget < total_price_per_loaf:
        break

    budget -= total_price_per_loaf
    bread_count += 1
    eggs_count += 3

    if bread_count%3 == 0:
        eggs_count -= (bread_count - 2)

print(f'You made {bread_count} loaves of Easter bread! Now you have {eggs_count} eggs and {budget:.2f}BGN left.')
