destinations = input()

while True:
    command = input().split(':')
    if command[0] == 'Travel':
        print(f'Ready for world tour! Planned stops: {destinations}')
        break

    if command[0] == 'Add Stop':
        index = int(command[1])
        stop = command[2]
        if 0 <= index <= len(destinations):
            left_part = destinations[:index]
            right_part = destinations[index:]
            destinations = left_part + stop + right_part
        print(destinations)

    elif command[0] == 'Remove Stop':
        start_index = int(command[1])
        end_index = int(command[2])
        if 0<= start_index <= end_index < len(destinations):
                first_part = destinations[:start_index]
                second_part = destinations[end_index + 1:]
                destinations = first_part + second_part
        print(destinations)

    elif command[0] == 'Switch':
        old_string = command[1]
        new_string = command[2]
        if old_string in destinations:
            destinations = destinations.replace(old_string, new_string)
        print(destinations)







