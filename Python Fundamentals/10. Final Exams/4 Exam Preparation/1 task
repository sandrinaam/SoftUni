string = input()

while True:
    command = input().split()
    if command[0] == 'Done':
        print(f'Your password is: {string}')
        break
    if command[0] == 'TakeOdd':
        new_password = ''
        for char in range(1,len(string), 2):
            new_password += string[char]
        string = new_password
        print(string)

    elif command[0] == 'Cut':
        index, length = int(command[1]), int(command[2])
        first_part = string[:index]
        second_part = string[index + length:]
        string = first_part + second_part
        print(string)

    elif command[0] == 'Substitute':
        substring, substitution = command[1], command[2]
        if substring in string:
            string = string.replace(substring, substitution)
            print(string)
        else:
            print('Nothing to replace!')




