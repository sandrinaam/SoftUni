number_of_pieces = int(input())
dictionary = {}

for _ in range(number_of_pieces):
    data = input().split('|')
    piece,composer,key = data[0], data[1], data[2]
    dictionary[piece] = {'composer': composer, 'key': key}

while True:
    command = input().split('|')
    if command[0] == 'Stop':
        break

    elif command[0] == 'Add':
        piece,composer,key = command[1], command[2], command[3]
        if piece in dictionary:
            print(f'{piece} is already in the collection!')
        else:
            dictionary[piece] = {'composer': composer, 'key': key}
            print(f'{piece} by {composer} in {key} added to the collection!')

    elif command[0] == 'Remove':
        piece = command[1]
        if piece in dictionary:
            del dictionary[piece]
            print(f'Successfully removed {piece}!')
        else:
            print(f'Invalid operation! {piece} does not exist in the collection.')

    elif command[0] == 'ChangeKey':
        piece, new_key = command[1], command[2]
        if piece in dictionary:
            dictionary[piece]['key'] = new_key
            print(f'Changed the key of {piece} to {new_key}!')
        else:
            print(f'Invalid operation! {piece} does not exist in the collection.')

for piece, stock in dictionary.items():
    print(f'{piece} -> Composer: {stock["composer"]}, Key: {stock["key"]}')



