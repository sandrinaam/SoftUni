board = [
    list(map(int, input().split())),
    list(map(int, input().split())),
    list(map(int, input().split())),
]

winner = 0

for row in board:
    if row[0] == row[1] == row[2]:
        winner = row[0]

for col in range(3):
    if board[0][col] == board[1][col] == board[2][col]:
        winner = board[0][col]

if board[0][0] == board[1][1] == board[2][2] !=0:
    winner = board[0][0]

if board[0][2] == board[1][1] == board[2][0] !=0:
    winner = board[0][2]

if winner == 1:
    print('First player won')
elif winner == 2:
    print('Second player won')
else:
    print('Draw!')

