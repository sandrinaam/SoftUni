numbers = input().split()
list_numbers = list(map(int, numbers))
num_k = int(input())
current_index = 0
final_list = []
while True:
    if len(list_numbers) == 0:
        break
    index = (current_index + num_k - 1) % len(list_numbers)
    final_list.append(list_numbers[index])
    list_numbers.pop(index)
    current_index = index

print(f'[{",".join(map(str, final_list))}]')



