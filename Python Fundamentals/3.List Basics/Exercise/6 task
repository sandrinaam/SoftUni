import numbers

integers = input().split()
count_numbers_to_remove = int(input())
list_of_integers = []
for integer in integers:
    list_of_integers.append(int(integer))

for _ in range(count_numbers_to_remove):
    smallest = min(list_of_integers)
    list_of_integers.remove(smallest)

print(', '.join(map(str, list_of_integers)))



