items = input().split('|')
budget = int(input())
ticket_price = 150
list_bought_items = []
money_spent = 0


for item in items:
    item_type, item_price = item.split('->')
    if item_type == 'Clothes':
        if float(item_price) <= 50:
            if budget >= float(item_price):
                budget -= float(item_price)
                money_spent += float(item_price)
                new_price = float(item_price) * 1.4
                list_bought_items.append(new_price)
        continue

    elif item_type == 'Shoes':
        if float(item_price) <= 35:
            if budget >= float(item_price):
                budget -= float(item_price)
                money_spent += float(item_price)
                new_price = float(item_price) * 1.4
                list_bought_items.append(new_price)
        continue

    elif item_type == 'Accessories':
        if float(item_price) <= 20.5:
            if budget >= float(item_price):
                budget -= float(item_price)
                money_spent += float(item_price)
                new_price = float(item_price) * 1.4
                list_bought_items.append(new_price)
        continue

print(" ".join(f'{item:.2f}' for item in list_bought_items))
profit = sum(list_bought_items) - money_spent
print(f'Profit: {profit:.2f}')
budget += sum(list_bought_items)
if budget >= ticket_price:
    print('Hello, France!')
else:
    print('Not enough money.')






