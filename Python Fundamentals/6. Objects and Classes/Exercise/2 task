class Weapon:
    bullets = 0

    def __init__(self, bullets: int):
        self.bullets = bullets
        Weapon.bullets += bullets

    def shoot(self):
        if Weapon.bullets > 0:
            self.bullets -= 1
            return 'shooting...'
        elif Weapon.bullets == 0:
            return 'no bullets left'

    def __repr__(self):
        message = f'Remaining bullets: {Weapon.bullets}'
        return message

