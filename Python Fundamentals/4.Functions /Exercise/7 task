def min_max_sum(digit_number: list) -> str:
    min_num = min(digit_number)
    max_num = max(digit_number)
    sum_num = sum(digit_number)
    return f'The minimum number is {min_num}\nThe maximum number is {max_num}\nThe sum number is: {sum_num}'


sequence_of_numbers = input().split()
digit_num = []
for num in sequence_of_numbers:
    digit_num.append(int(num))
result = min_max_sum(digit_num)
print(result)
