def correct_length(password: str) -> bool or str:
    if 6 <= len(password) <= 10:
        return True
    return 'Password must be between 6 and 10 characters'

def letter_and_digit(password: str) -> bool or str:
    if password.isalnum():
        return True
    return 'Password must consist only of letters and digits'

def two_digits(password: str) -> bool or str:
    digit_counter = 0
    for digit in password:
        if digit.isdigit():
            digit_counter += 1
    if digit_counter >= 2:
        return True
    return 'Password must have at least 2 digits'

def validate_password(password: str):
    is_valid = []
    is_valid.append(correct_length(password))
    is_valid.append(letter_and_digit(password))
    is_valid.append(two_digits(password))
    while True in is_valid:
        is_valid.remove(True)

    return is_valid

my_password = input()
password_is_not_valid = validate_password(my_password)
if password_is_not_valid:
    print('\n'.join(password_is_not_valid))
else:
    print('Password is valid')






