distances = list(map(int, input().split()))
sum_of_removed = 0

while distances:
    index = int(input())

    if index < 0:
        removed = distances[0]
        distances[0] = distances[-1]

    elif index >= len(distances):
        removed = distances[-1]
        distances[-1] = distances[0]

    else:
        removed = distances[index]
        distances.pop(index)

    sum_of_removed += removed

    for i in range(len(distances)):
        if distances[i] <= removed:
            distances[i] += removed
        else:
            distances[i] -= removed

print(sum_of_removed)





